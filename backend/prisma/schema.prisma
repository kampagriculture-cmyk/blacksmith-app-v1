generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model defect_entries {
  id                Int             @id @default(autoincrement())
  production_log_id Int
  defect_type_code  String          @db.VarChar(10)
  qty               Int
  defect_types      defect_types    @relation(fields: [defect_type_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  production_logs   production_logs @relation(fields: [production_log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([production_log_id, defect_type_code])
}

model defect_types {
  code           String           @id @db.VarChar(10)
  name_th        String           @db.VarChar(100)
  display_order  Int              @db.SmallInt
  defect_entries defect_entries[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employees {
  id                                                       Int               @id @default(autoincrement())
  name                                                     String            @db.VarChar(100)
  role                                                     String            @db.VarChar(20)
  active                                                   Boolean           @default(true)
  machine_owners                                           machine_owners[]
  production_logs_production_logs_operator_idToemployees   production_logs[] @relation("production_logs_operator_idToemployees")
  production_logs_production_logs_supervisor_idToemployees production_logs[] @relation("production_logs_supervisor_idToemployees")
  receipt_log                                              receipt_log[]
  withdrawal_log                                           withdrawal_log[]
}

model knives {
  id              Int               @id @default(autoincrement())
  code            String            @unique @db.VarChar(20)
  production_logs production_logs[]
}

model machine_owners {
  machine_id  Int       @id
  operator_id Int
  machines    machines  @relation(fields: [machine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees   employees @relation(fields: [operator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model machines {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(20)
  machine_owners  machine_owners?
  production_logs production_logs?
  withdrawal_log  withdrawal_log[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model production_logs {
  id                                                 Int              @id @default(autoincrement())
  machine_id                                         Int              @unique(map: "one_in_progress_per_machine", where: raw("((status)::text = 'in_progress'::text)"))
  knife_id                                           Int
  lot_no                                             String           @db.VarChar(50)
  status                                             String           @default("completed") @db.VarChar(20)
  ended_at                                           DateTime?        @db.Timestamp(6)
  total_qty                                          Int?
  operator_id                                        Int
  supervisor_id                                      Int?
  qc_approved                                        Boolean?
  remark                                             String?
  created_at                                         DateTime         @default(now()) @db.Timestamp(6)
  updated_at                                         DateTime         @default(now()) @db.Timestamp(6)
  started_at                                         DateTime?        @db.Timestamp(6)
  defect_entries                                     defect_entries[]
  knives                                             knives           @relation(fields: [knife_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machines                                           machines         @relation(fields: [machine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees_production_logs_operator_idToemployees   employees        @relation("production_logs_operator_idToemployees", fields: [operator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees_production_logs_supervisor_idToemployees employees?       @relation("production_logs_supervisor_idToemployees", fields: [supervisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stone_changes                                      stone_changes?
  tune_rounds                                        tune_rounds[]
}

model stone_changes {
  id                Int             @id @default(autoincrement())
  production_log_id Int             @unique
  qty_before_change Int
  size_left         String?         @db.VarChar(20)
  size_right        String?         @db.VarChar(20)
  downtime_start    DateTime?       @db.Time(6)
  downtime_end      DateTime?       @db.Time(6)
  production_logs   production_logs @relation(fields: [production_log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tune_rounds {
  id                Int             @id @default(autoincrement())
  production_log_id Int
  round_no          Int             @db.SmallInt
  start_time        DateTime        @db.Time(6)
  end_time          DateTime        @db.Time(6)
  production_logs   production_logs @relation(fields: [production_log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([production_log_id, round_no])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item_master {
  id             String           @id @db.VarChar(30)
  name           String           @db.VarChar(120)
  unit           String           @db.VarChar(20)
  reorder_point  Int              @default(0)
  active         Boolean          @default(true)
  receipt_log    receipt_log[]
  withdrawal_log withdrawal_log[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model withdrawal_log {
  id            Int         @id @default(autoincrement())
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  item_id       String      @db.VarChar(30)
  qty           Int
  withdrawer_id Int
  machine_id    Int?
  condition     String?     @db.VarChar(60)
  reason        String?
  remark        String?
  item_master   item_master @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  machines      machines?   @relation(fields: [machine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees     employees   @relation(fields: [withdrawer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([item_id], map: "idx_withdrawal_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model receipt_log {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  item_id     String      @db.VarChar(30)
  qty         Int
  receiver_id Int
  source      String?     @db.VarChar(120)
  remark      String?
  item_master item_master @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees   employees   @relation(fields: [receiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([item_id], map: "idx_receipt_item")
}
