# Postgres connection string (Neon in production — see backend/.env for the real value, gitignored).
DATABASE_URL=

# Comma-separated list of allowed frontend origins for CORS.
# Local dev default (used when unset): http://localhost:3002
# On Vercel, set this to the frontend project's *.vercel.app URL (add more, comma-separated, for a custom domain too).
CORS_ORIGINS=http://localhost:3002
